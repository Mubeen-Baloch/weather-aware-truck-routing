# Development-only values. Keep the real .env private.
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Local development defaults to deterministic fixture mode and requires no provider credentials.
# Set ROUTING_DATA_MODE=live explicitly only when testing live providers.
ROUTING_DATA_MODE=fixture
ROUTING_FIXTURE_SCENARIO=standard
PROVIDER_REQUEST_TIMEOUT_SECONDS=10
PROVIDER_CACHE_TTL_SECONDS=300

# Required only when ROUTING_DATA_MODE=live. Never commit a real token.
MAPBOX_ACCESS_TOKEN=
